# --- NO AT COUNTERPART: members Forge and NeoForge widen by PATCHING the vanilla jar ---
#
# Everything above mirrors an entry in accesstransformer_mojmap.cfg. These do not, and that is
# not an oversight in the AT: both Forge and NeoForge ship a patched Minecraft jar in which
# these members are already public, so a Forge-authored mod never has to ask. Fabric's jar is
# unpatched, so the mod's ordinary source — which has compiled on both loaders since 1.20.1 —
# stops compiling here until each one is widened explicitly.
#
# This is the part of the file most likely to GROW as a node is added, because it tracks the
# loaders' patch sets rather than this mod's own access needs. Read every descriptor off the
# unpatched jar (`javap -p -s`), never from memory.
accessible	field	net/minecraft/world/entity/Mob	goalSelector	Lnet/minecraft/world/entity/ai/goal/GoalSelector;
accessible	field	net/minecraft/world/entity/Mob	targetSelector	Lnet/minecraft/world/entity/ai/goal/GoalSelector;
accessible	field	net/minecraft/client/gui/screens/Screen	renderables	Ljava/util/List;
accessible	method	net/minecraft/world/entity/Entity	getEncodeId	()Ljava/lang/String;
accessible	method	net/minecraft/world/level/block/Block	popExperience	(Lnet/minecraft/server/level/ServerLevel;Lnet/minecraft/core/BlockPos;I)V
accessible	method	net/minecraft/client/renderer/entity/LivingEntityRenderer	addLayer	(Lnet/minecraft/client/renderer/entity/layers/RenderLayer;)Z
# Registering a particle type means constructing one; the ctor is protected in vanilla.
accessible	method	net/minecraft/core/particles/SimpleParticleType	<init>	(Z)V
# The 4-arg ctor is PRIVATE in vanilla — the mod's own DamageSource subclass super()s to it.
accessible	method	net/minecraft/world/damagesource/DamageSource	<init>	(Lnet/minecraft/core/Holder;Lnet/minecraft/world/entity/Entity;Lnet/minecraft/world/entity/Entity;Lnet/minecraft/world/phys/Vec3;)V
# 1.20.5 made SpawnPlacements.register private (verified by javap on the unpatched Fabric jar, so
# this is vanilla and not a loader patch) — both loaders route registration through their own
# SpawnPlacementRegisterEvent instead. Fabric API has no such event, so AMEntityRegistry.placement
# calls vanilla's registrar directly there. Below 1.20.5 it is already public and this entry is a
# harmless no-op, but the placement-type argument was still the nested SpawnPlacements$Type.
#? <1.20.5
accessible	method	net/minecraft/world/entity/SpawnPlacements	register	(Lnet/minecraft/world/entity/EntityType;Lnet/minecraft/world/entity/SpawnPlacements$Type;Lnet/minecraft/world/level/levelgen/Heightmap$Types;Lnet/minecraft/world/entity/SpawnPlacements$SpawnPredicate;)V
#? >=1.20.5
accessible	method	net/minecraft/world/entity/SpawnPlacements	register	(Lnet/minecraft/world/entity/EntityType;Lnet/minecraft/world/entity/SpawnPlacementType;Lnet/minecraft/world/level/levelgen/Heightmap$Types;Lnet/minecraft/world/entity/SpawnPlacements$SpawnPredicate;)V
# MenuScreens.register is PRIVATE in vanilla and its ScreenConstructor is package-private
# (javap-verified on the unpatched 26.2 jar, so this is vanilla, not a loader patch). Forge kept
# it public; NeoForge closed it off at 20.6 and routes registration through RegisterMenuScreensEvent
# — which is why the call site in ClientProxy.clientInit is gated `forge || fabric || <1.20.6`.
# Fabric API's own fabric-screen-handler-api-v1 widens exactly these two, but in the INTERMEDIARY
# namespace, which an unobfuscated no-remap node has no mappings tree to resolve — so widen them
# ourselves rather than depend on a transitive AW landing.
accessible	class	net/minecraft/client/gui/screens/MenuScreens$ScreenConstructor
accessible	method	net/minecraft/client/gui/screens/MenuScreens	register	(Lnet/minecraft/world/inventory/MenuType;Lnet/minecraft/client/gui/screens/MenuScreens$ScreenConstructor;)V
# BlockEntityType.Builder was deleted at 1.21.2, so AMTileEntityRegistry constructs the type
# directly — and on 26.1.2 vanilla BOTH the constructor and the BlockEntitySupplier interface are
# non-public (javap on the unpatched jar: `private BlockEntityType(...)`, package-private
# `interface BlockEntitySupplier`). Forge and NeoForge patch them open, which is why only Fabric
# needs this; 26.2 made both public in vanilla, where they are simply a no-op. Below 1.21.2 the
# ctor still took the datafixer Type that Builder used to supply.
accessible	class	net/minecraft/world/level/block/entity/BlockEntityType$BlockEntitySupplier
#? <1.21.2
accessible	method	net/minecraft/world/level/block/entity/BlockEntityType	<init>	(Lnet/minecraft/world/level/block/entity/BlockEntityType$BlockEntitySupplier;Ljava/util/Set;Lcom/mojang/datafixers/types/Type;)V
#? >=1.21.2
accessible	method	net/minecraft/world/level/block/entity/BlockEntityType	<init>	(Lnet/minecraft/world/level/block/entity/BlockEntityType$BlockEntitySupplier;Ljava/util/Set;)V
# The vanilla block-model Gson adapters the vendored Tabula loader registers. The CLASSES are
# public; it is their no-arg constructors that vanilla declares `protected` (javap -p -s on the
# unpatched named jar: `protected ...$Deserializer(); descriptor: ()V`). Forge and NeoForge both
# patch them public, which is why TabulaModelHandler / TabulaModelBlock have compiled there since
# 1.20.1 with no AT entry. Only reachable below 26 — the >=26 arms of both files drop the adapters
# and ModPlatformPlugin excludes TabulaModelBlock outright there.
#?{ <26
accessible	method	net/minecraft/client/renderer/block/model/ItemTransforms$Deserializer	<init>	()V
accessible	method	net/minecraft/client/renderer/block/model/ItemTransform$Deserializer	<init>	()V
accessible	method	net/minecraft/client/renderer/block/model/BlockElement$Deserializer	<init>	()V
accessible	method	net/minecraft/client/renderer/block/model/BlockElementFace$Deserializer	<init>	()V
#?}
