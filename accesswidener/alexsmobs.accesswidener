accessible	method	net/minecraft/client/renderer/block/model/BlockFaceUV$Deserializer	<init>	()V
#? <1.21.4
accessible	method	net/minecraft/client/renderer/block/model/ItemOverride$Deserializer	<init>	()V
# AMCompat.ingredientOfTags builds a multi-tag Ingredient the pre-1.21.2 way: a stream of
# Ingredient.TagValue handed to Ingredient.fromValues. In vanilla the nested class, its constructor
# AND fromValues are all non-public (javap -p: `class ...$TagValue`, package-private <init>,
# `private static ... fromValues(...)`); Forge and NeoForge patch all three. 1.21.2 made Ingredient
# HolderSet-backed and deleted the lot, which is what the >=1.21.2 arm of that method targets.
#?{ <1.21.2
accessible	class	net/minecraft/world/item/crafting/Ingredient$TagValue
accessible	method	net/minecraft/world/item/crafting/Ingredient$TagValue	<init>	(Lnet/minecraft/tags/TagKey;)V
accessible	method	net/minecraft/world/item/crafting/Ingredient	fromValues	(Ljava/util/stream/Stream;)Lnet/minecraft/world/item/crafting/Ingredient;
#?}

